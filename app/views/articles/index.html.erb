<h1>Articles</h1>

<% @articles.each do |article| %>
  <h2><%= link_to article.title, article_path(article) %></h2>
  <p><%= article.body %></p>
<% end %>

<% if request.authorization == ActionController::HttpAuthentication::Basic.encode_credentials("dhh", "secret") %>
  <%= link_to "New Article", new_article_path %>
<% end %>
