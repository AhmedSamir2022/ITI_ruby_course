<section class="article-details">
  <h1 class="page-title"><%= @article.title %></h1>

  <div class="article-body">
    <%= simple_format(@article.content) %>
  </div>

  <% if @article.image.present? %>
    <div class="article-image-large">
      <%= image_tag @article.image.url, alt: @article.title, class: "article-image-large__img" %>
    </div>
  <% end %>

  <div class="article-meta-box">
    <p>Written by: <%= @article.user.email %></p>
    <p>Reports: <%= @article.reports_count || 0 %></p>
  </div>

  <% if user_signed_in? && @article.user == current_user %>
    <div class="page-actions">
      <%= link_to "Edit", edit_article_path(@article), class: "btn btn-primary" %>
      <%= link_to "Delete", @article, method: :delete,
          class: "btn btn-danger-outline",
          data: { confirm: "Are you sure you want to delete this article?" } %>
    </div>
  <% end %>

  <div class="page-actions">
    <%= link_to "← Back to Articles", articles_path, class: "btn btn-secondary" %>
  </div>
</section>
